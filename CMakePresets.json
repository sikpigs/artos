{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "STM32F411 Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KCONFIG_DEFCONFIG": "${sourceDir}/configs/nucleo_f411re_defconfig"
      }
    },
    {
      "name": "release",
      "displayName": "STM32F411 Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KCONFIG_DEFCONFIG": "${sourceDir}/configs/nucleo_f411re_defconfig"
      }
    },
    {
      "name": "f439-debug",
      "displayName": "NUCLEO-F439ZI Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KCONFIG_DEFCONFIG": "${sourceDir}/configs/nucleo_f439zi_defconfig"
      }
    },
    {
      "name": "f439-release",
      "displayName": "NUCLEO-F439ZI Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KCONFIG_DEFCONFIG": "${sourceDir}/configs/nucleo_f439zi_defconfig"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "STM32F411 Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "STM32F411 Release",
      "configurePreset": "release"
    },
    {
      "name": "f439-debug",
      "configurePreset": "f439-debug"
    },
    {
      "name": "f439-release",
      "configurePreset": "f439-release"
    }
  ]
}
