{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug selected host test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "Build host tests",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerArgs": "-nx",
      "setupCommands": [
        {
          "description": "Load the workspace GDB settings",
          "text": "source ${workspaceFolder}/.gdbinit",
          "ignoreFailures": false
        },
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
