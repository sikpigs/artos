{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "cmake",
      "command": "configure",
      "preset": "${command:cmake.activeConfigurePresetName}",
      "problemMatcher": [],
      "detail": "Configure using the preset selected in CMake Tools"
    },
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "CMake: configure"
      ],
      "detail": "Build using the preset selected in CMake Tools"
    },
    {
      "label": "Build Debug firmware",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/artos.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Configure host tests",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "host-tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build host tests",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Configure host tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Tests: all",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build host tests"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: native",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "native"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build host tests"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: python",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "python"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build host tests"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: hooks",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "hooks"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Build host tests"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Flash configured board",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/artos.py",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Serial console",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/artos.py",
        "monitor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "ST-LINK virtual COM port at 115200 baud; Ctrl+] exits. Set NUCLEO_SERIAL_PORT to override auto-detection (Linux/POSIX)."
    }
  ]
}
