{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "cmake",
      "command": "configure",
      "preset": "${command:cmake.activeConfigurePresetName}",
      "problemMatcher": [],
      "detail": "Configure using the preset selected in CMake Tools"
    },
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOn": [
        "CMake: configure"
      ],
      "detail": "Build using the preset selected in CMake Tools"
    },
    {
      "label": "Configure Debug firmware",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug firmware",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "Configure Debug firmware"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Flash configured board",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug",
        "--target",
        "flash"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "dependsOn": [
        "Configure Debug firmware"
      ]
    },
    {
      "label": "Serial console",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/serial_console.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "ST-LINK virtual COM port at 115200 baud; Ctrl+] exits. Set NUCLEO_SERIAL_PORT to override auto-detection (Linux/POSIX)."
    }
  ]
}
