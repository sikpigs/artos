config SOC_STM32F411
    bool
    select CPU_CORTEX_M4F
    select CPU_HAS_STACK_PROTECTION

config SOC_STM32F439
    bool
    select CPU_CORTEX_M4F
    select CPU_HAS_STACK_PROTECTION

config CPU_HAS_STACK_PROTECTION
    bool

config CPU_CORTEX_M4F
    bool

config SOC_PATH
    string
    default "st/stm32f4/stm32f411" if SOC_STM32F411
    default "st/stm32f4/stm32f439" if SOC_STM32F439

config SOC_NAME
    string
    default "stm32f411" if SOC_STM32F411
    default "stm32f439" if SOC_STM32F439

config CPU_NAME
    string
    default "cortex_m4" if CPU_CORTEX_M4F
